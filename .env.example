# Copy to .env and fill in with your Supabase project's connection strings
# (Project Settings -> Database -> Connection string in the Supabase dashboard).

# Pooled connection (via Supabase's pooler, port 6543) - used by the app at runtime
# (see src/lib/prisma.ts). Cheap to open/close per request, which suits serverless.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler connection (port 5432, via the pooler host) - used by
# `prisma migrate deploy` in CI/production. NOT the raw "direct connection"
# (db.[PROJECT-REF].supabase.co) - that host is IPv6-only unless you've paid
# for Supabase's IPv4 add-on, and Vercel's build environment has no IPv6
# egress, so migrations fail to connect (P1001) from there. The session
# pooler is IPv4-compatible and still supports the DDL migrations need,
# unlike the transaction pooler used for DATABASE_URL above. Get this exact
# string from Supabase's dashboard: Project Settings -> Database ->
# Connection string -> "Session pooler" (not "Direct connection").
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Only needed locally when authoring new migrations with `prisma migrate dev`, which
# requires a shadow database to detect drift. Point it at a local Postgres instance
# rather than Supabase - run migrate dev against a local database, commit the generated
# migration, then `prisma migrate deploy` applies it to Supabase (no shadow db there).
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/workout_tracker_shadow?schema=public"
