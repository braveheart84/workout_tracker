// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum SetType {
  REPS
  DURATION
  DISTANCE
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DISCARDED
}

enum WorkoutSessionType {
  STRENGTH
  RUN
}

enum WorkoutSessionSource {
  MANUAL
  AI_GENERATED
}

// PRD Section 9 (User)
model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  unitSystem        UnitSystem @default(METRIC) @map("unit_system")
  remindersEnabled  Boolean    @default(true) @map("reminders_enabled")
  createdAt         DateTime   @default(now()) @map("created_at")

  exercises       Exercise[]
  workoutSessions WorkoutSession[]

  @@map("users")
}

// PRD Section 9 (Exercise) - per-user exercise library
model Exercise {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  muscleGroup    String?  @map("muscle_group")
  defaultSetType SetType  @default(REPS) @map("default_set_type")
  createdAt      DateTime @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@map("exercises")
}

// PRD Section 9 (WorkoutSession) - fields introduced by later PRs (plan_id,
// template_id, focus_tags, post-workout feedback fields) are added by the
// PRs that actually use them, not sketched in ahead of need.
model WorkoutSession {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  date          DateTime             @db.Date
  status        WorkoutSessionStatus @default(IN_PROGRESS)
  type          WorkoutSessionType   @default(STRENGTH)
  label         String?
  warmupNotes   String?              @map("warmup_notes")
  finisherNotes String?              @map("finisher_notes")
  cooldownNotes String?              @map("cooldown_notes")
  source        WorkoutSessionSource @default(MANUAL)
  createdAt     DateTime             @default(now()) @map("created_at")
  startedAt     DateTime?            @map("started_at")
  completedAt   DateTime?            @map("completed_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks WorkoutBlock[]

  @@map("workout_sessions")
}

// PRD Section 9 (WorkoutBlock) - groups one or more exercises done together
// for N rounds; a single-exercise, 1-round block is just a normal exercise.
model WorkoutBlock {
  id          String @id @default(uuid())
  sessionId   String @map("session_id")
  order       Int
  roundCount  Int    @default(1) @map("round_count")
  restSeconds Int?   @map("rest_seconds")

  session          WorkoutSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@map("workout_blocks")
}

// PRD Section 9 (WorkoutExercise)
model WorkoutExercise {
  id              String  @id @default(uuid())
  blockId         String  @map("block_id")
  exerciseId      String  @map("exercise_id")
  order           Int
  noteForNextTime String? @map("note_for_next_time")

  block    WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@map("workout_exercises")
}
