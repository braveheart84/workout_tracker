// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum SetType {
  REPS
  DURATION
  DISTANCE
}

// PRD Section 9 (User)
model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  unitSystem        UnitSystem @default(METRIC) @map("unit_system")
  remindersEnabled  Boolean    @default(true) @map("reminders_enabled")
  createdAt         DateTime   @default(now()) @map("created_at")

  exercises Exercise[]

  @@map("users")
}

// PRD Section 9 (Exercise) - per-user exercise library
model Exercise {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  muscleGroup    String?  @map("muscle_group")
  defaultSetType SetType  @default(REPS) @map("default_set_type")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("exercises")
}
