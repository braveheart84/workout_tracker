// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum SetType {
  REPS
  DURATION
  DISTANCE
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DISCARDED
}

enum WorkoutSessionType {
  STRENGTH
  RUN
}

enum WorkoutSessionSource {
  MANUAL
  AI_GENERATED
}

enum WeightUnit {
  KG
  LB
}

// PRD 7.2's focus-area shortcut (PR-21): steers what kind of session(s) the
// LLM proposes without dictating exact exercises.
enum FocusArea {
  STRENGTH
  CARDIO
  HIIT
  MOBILITY
}

// PRD Section 9 (User)
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String     @map("password_hash")
  unitSystem       UnitSystem @default(METRIC) @map("unit_system")
  remindersEnabled Boolean    @default(true) @map("reminders_enabled")
  createdAt        DateTime   @default(now()) @map("created_at")

  exercises        Exercise[]
  workoutSessions  WorkoutSession[]
  workoutPlans     WorkoutPlan[]
  workoutTemplates WorkoutTemplate[]

  @@map("users")
}

// PRD Section 9 (Exercise) - per-user exercise library
model Exercise {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  muscleGroup    String?  @map("muscle_group")
  defaultSetType SetType  @default(REPS) @map("default_set_type")
  createdAt      DateTime @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@map("exercises")
}

// PRD Section 9 (WorkoutSession) - fields introduced by later PRs (plan_id,
// template_id, focus_tags) are added by the PRs that actually use them, not
// sketched in ahead of need.
model WorkoutSession {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  planId           String?              @map("plan_id")
  date             DateTime             @db.Date
  status           WorkoutSessionStatus @default(IN_PROGRESS)
  type             WorkoutSessionType   @default(STRENGTH)
  label            String?
  warmupNotes      String?              @map("warmup_notes")
  finisherNotes    String?              @map("finisher_notes")
  cooldownNotes    String?              @map("cooldown_notes")
  difficultyRating Int?                 @map("difficulty_rating")
  difficultyNote   String?              @map("difficulty_note")
  energyRating     Int?                 @map("energy_rating")
  goalForNext      String?              @map("goal_for_next")
  source           WorkoutSessionSource @default(MANUAL)
  createdAt        DateTime             @default(now()) @map("created_at")
  startedAt        DateTime?            @map("started_at")
  completedAt      DateTime?            @map("completed_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   WorkoutPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  blocks WorkoutBlock[]

  @@map("workout_sessions")
}

// PRD Section 9 (WorkoutPlan) - groups the batch of sessions generated
// together by one multi-day generation request (PR-16); a single-day
// generation (PR-14) never creates one of these. `focusTags` and
// `basedOnSessionId` (PR-21) are the multi-day form's two generation
// shortcuts alongside free text - `basedOnSessionId` is provenance only,
// not a FK (mirrors WorkoutTemplate.createdFromSessionId), since the
// baseline session isn't deletable today and a plan is meant to outlive it
// either way.
model WorkoutPlan {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  startDate        DateTime    @map("start_date") @db.Date
  numDays          Int         @map("num_days")
  sourcePrompt     String?     @map("source_prompt")
  focusTags        FocusArea[] @map("focus_tags")
  basedOnSessionId String?     @map("based_on_session_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSessions WorkoutSession[]

  @@map("workout_plans")
}

// PRD Section 9 (WorkoutTemplate) - a named, reusable snapshot of a
// session's blocks/exercises/target sets (PR-20), saved explicitly from any
// accepted or completed session via "Save as Template." `structure` mirrors
// the same shape used for an AI suggestion (see workout-suggestion-schema.ts)
// so a template can be dropped straight into the existing suggestion
// review/accept UI as a generation shortcut, with no separate rendering
// path needed. `createdFromSessionId` is provenance only, not a FK - the
// source session isn't deletable today and a template is meant to outlive
// it either way. `focus_tags` from the PRD's schema sketch isn't added yet -
// PR-21 only adds it to WorkoutPlan, since tagging a saved template's own
// focus area is a separate, unrequested organizational feature.
model WorkoutTemplate {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  name                 String
  structure            Json
  createdFromSessionId String?  @map("created_from_session_id")
  createdAt            DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_templates")
}

// PRD Section 9 (WorkoutBlock) - groups one or more exercises done together
// for N rounds; a single-exercise, 1-round block is just a normal exercise.
model WorkoutBlock {
  id          String @id @default(uuid())
  sessionId   String @map("session_id")
  order       Int
  roundCount  Int    @default(1) @map("round_count")
  restSeconds Int?   @map("rest_seconds")

  session          WorkoutSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@map("workout_blocks")
}

// PRD Section 9 (WorkoutExercise) - target* fields carry the prescribed
// reps/duration/distance/weight from an AI-generated suggestion or template
// (PR-14, PR-20) through to logging time, so the user can see what they're
// aiming for each round. targetWeight/targetWeightUnit (PR-19) close a gap
// where the suggestion's weight was silently dropped on accept, since there
// was nowhere to keep it until now. All are null for a manually-added
// exercise, which has no such target.
model WorkoutExercise {
  id                    String      @id @default(uuid())
  blockId               String      @map("block_id")
  exerciseId            String      @map("exercise_id")
  order                 Int
  noteForNextTime       String?     @map("note_for_next_time")
  targetReps            Int?        @map("target_reps")
  targetDurationSeconds Int?        @map("target_duration_seconds")
  targetDistanceMeters  Float?      @map("target_distance_meters")
  targetWeight          Float?      @map("target_weight")
  targetWeightUnit      WeightUnit? @map("target_weight_unit")

  block    WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     Set[]

  @@map("workout_exercises")
}

// PRD Section 9 (Set) - one set per round for a workout exercise, or more
// if the user does extra sets within a round. `suggested_*` (PR-19) is
// stamped onto a new Set row at logging time from its WorkoutExercise's
// target* fields, when that exercise came from a plan - a snapshot of what
// was suggested for that specific round, preserved separately from what
// actually got logged, so generation can later compare the two (7.2).
// Null for a manually-added exercise, which had no suggestion to snapshot.
model Set {
  id                       String      @id @default(uuid())
  workoutExerciseId        String      @map("workout_exercise_id")
  roundNumber              Int         @map("round_number")
  setType                  SetType     @map("set_type")
  reps                     Int?
  weight                   Float?
  weightUnit               WeightUnit? @map("weight_unit")
  durationSeconds          Int?        @map("duration_seconds")
  distanceMeters           Float?      @map("distance_meters")
  suggestedReps            Int?        @map("suggested_reps")
  suggestedWeight          Float?      @map("suggested_weight")
  suggestedWeightUnit      WeightUnit? @map("suggested_weight_unit")
  suggestedDurationSeconds Int?        @map("suggested_duration_seconds")
  suggestedDistanceMeters  Float?      @map("suggested_distance_meters")
  createdAt                DateTime    @default(now()) @map("created_at")

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@map("sets")
}
